n1 = int(input('Digite um numero para fazer a tabuada: '))



def soma(x,i):
  par = (x + i) % 2 == 0          # True se a soma for par

  r = f'{x} x {i} = {x * i}'
  s = f'{x} + {i} = {x + i}'
  return r,s,par

cores={'limpa' :'\033[m',
        'roxo':'\033[35m',
        'azul marinho' :'\033[36m',
        'azul' :'\033[34m'}

for i in range(n1,10):
    r,s, par = soma(n1,i) 
    if par:    
     print('{}{}{} | {}{}{}  '.format(
    cores['azul marinho'], r ,cores['limpa'],
    cores['azul'],s,cores['limpa']))
    

